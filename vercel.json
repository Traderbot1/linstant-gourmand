{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/atelier", "destination": "/#atelier", "permanent": true },
    { "source": "/atelier/", "destination": "/#atelier", "permanent": true },
    { "source": "/creations.html", "destination": "/creations/", "permanent": true },
    { "source": "/commander.html", "destination": "/commander/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
